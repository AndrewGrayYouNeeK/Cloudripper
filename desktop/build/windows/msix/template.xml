<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cloudripper-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\YouNeeK\CloudRipper">
    </Installer>
    <PackageInformation
        PackageName="CloudRipper"
        PackageDisplayName="CloudRipper"
        PublisherName="CN=YouNeeK"
        PublisherDisplayName="YouNeeK"
        Version="0.3.0.0"
        PackageDescription="Read-only desktop app for CloudRipper">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.youneek.cloudripper"
                Description="Read-only desktop app for CloudRipper"
                DisplayName="CloudRipper"
                ExecutableName="cloudripper-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CloudRipper</DisplayName>
            <PublisherDisplayName>YouNeeK</PublisherDisplayName>
            <Description>Read-only desktop app for CloudRipper</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cloudripper-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
